server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Nøkkelen legges på her; access-loggen viser bare klientens opprinnelige forespørsel.
    location /api/ {
        limit_except GET { deny all; }
        # NB: set må stå før rewrite ... break, ellers kjøres den ikke.
        set $args "$args&key=${SHODAN_API_KEY}";
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass https://api.shodan.io;
        proxy_set_header Host api.shodan.io;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_read_timeout 60s;
        proxy_hide_header Set-Cookie;
    }

    # Shodan InternetDB (gratis, ingen nøkkel)
    location /internetdb/ {
        limit_except GET { deny all; }
        proxy_pass https://internetdb.shodan.io/;
        proxy_set_header Host internetdb.shodan.io;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_read_timeout 30s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
